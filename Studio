local tabList = {
	{ button = Main, indicator = ImageLabel },
	{ button = Dung, indicator = ImageLabel_2 },
	{ button = Farm, indicator = ImageLabel_3 }
}

local function switchTab(selected)
	for _, tab in ipairs(tabList) do
		if tab == selected then
			tab.indicator.Visible = true -- เปิดแท็บที่กด
		else
			tab.indicator.Visible = false -- ปิดแท็บอื่นๆ ทั้งหมด
		end
	end
end

for _, tab in ipairs(tabList) do
	tab.button.MouseButton1Click:Connect(function()
		switchTab(tab)
	end)
end

-- ==============================================================================
-- 2. ระบบ Tween Search Box (เปิด/ปิด อัตโนมัติ)
-- ==============================================================================
local isSearchOpen = false
local currentTween = nil
local openTweenInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
local closeTweenInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function openSearch()
	if isSearchOpen then return end
	isSearchOpen = true
	TextBox.Visible = true

	if currentTween then currentTween:Cancel() end
	TweenService:Create(Icon_2, openTweenInfo, { ImageColor3 = Color3.fromRGB(255, 255, 255) }):Play()
	currentTween = TweenService:Create(TextBox, openTweenInfo, {
		Size = UDim2.new(0, 150, 0, 26),
		BackgroundTransparency = 0,
		TextTransparency = 0
	})
	currentTween:Play()

	task.defer(function()
		TextBox:CaptureFocus()
	end)
end

local function closeSearch()
	if not isSearchOpen then return end
	isSearchOpen = false
	TextBox:ReleaseFocus()

	if currentTween then currentTween:Cancel() end
	TweenService:Create(Icon_2, closeTweenInfo, { ImageColor3 = Color3.fromRGB(147, 147, 147) }):Play()
	currentTween = TweenService:Create(TextBox, closeTweenInfo, {
		Size = UDim2.new(0, 0, 0, 26),
		BackgroundTransparency = 1,
		TextTransparency = 1
	})
	currentTween:Play()

	currentTween.Completed:Connect(function()
		if not isSearchOpen then
			TextBox.Visible = false
		end
	end)
end

Button_2.MouseButton1Click:Connect(function()
	if isSearchOpen then
		closeSearch()
	else
		openSearch()
	end
end)

TextBox.FocusLost:Connect(function(enterPressed)
	closeSearch()
	if enterPressed and TextBox.Text ~= "" then
		print("ค้นหาคำว่า:", TextBox.Text)
	end
end)

